!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
 
# JetBrains
.idea/
 
# Temporary / backup files
*.tmp
*.temp
*.bak
*.orig
*.cache
 
# Local temporal files
tmp/
temp/
scratch/
 
