<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VenueOps.ViewModels"
    x:Class="VenueOps.Views.Auth.LoginView"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <ScrollView>
        <Grid MinimumHeightRequest="600">

            <!-- Full-screen background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{AppThemeBinding Light=#E8F5EE, Dark=#091413}" Offset="0"/>
                    <GradientStop Color="{AppThemeBinding Light=#F0F8F4, Dark=#0F1F1C}" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Width is driven by OnSizeAllocated in code-behind:
                 WidthRequest = Min(pageWidth, 560) so it fills narrow screens
                 and caps at 560dp on wide ones. HorizontalOptions=Center centers
                 it once the page is wider than 560. -->
            <VerticalStackLayout
                x:Name="ContentLayout"
                HorizontalOptions="Center"
                Padding="24,60,24,40"
                Spacing="0"
                VerticalOptions="Center">

                <!-- ── Branding ──────────────────────────────────── -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,44">
                    <Label
                        Text="VenueOps"
                        Style="{StaticResource DisplayTitle}"
                        SemanticProperties.HeadingLevel="Level1"/>
                    <Label
                        Text="Every event. Every space. One platform."
                        Style="{StaticResource BodySecondary}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- ── Login Card ────────────────────────────────── -->
                <Border Style="{StaticResource Card}" Padding="28,24">

                    <VerticalStackLayout Spacing="0">

                        <Label
                            Text="Welcome back"
                            Style="{StaticResource SubHeadline}"
                            HorizontalOptions="Center"
                            Margin="0,0,0,24"/>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                            <Label Text="Email" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Enter your email"
                                    Text="{Binding Email}"
                                    Keyboard="Email"
                                    ReturnType="Next"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    AutomationId="EmailEntry"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="6" Margin="0,0,0,24">
                            <Label Text="Password" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Enter your password"
                                    Text="{Binding Password}"
                                    IsPassword="True"
                                    ReturnType="Done"
                                    ReturnCommand="{Binding LoginCommand}"
                                    IsSpellCheckEnabled="False"
                                    IsTextPredictionEnabled="False"
                                    AutomationId="PasswordEntry"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error message — 24dp below matches the 24dp gap above (from password margin),
                             so the button always has equal breathing room regardless of error state. -->
                        <Label
                            Text="{Binding ErrorMessage}"
                            Style="{StaticResource ErrorText}"
                            IsVisible="{Binding HasError}"
                            Margin="0,0,0,24"
                            AutomationId="ErrorLabel"/>

                        <!-- Sign In button -->
                        <Button
                            Text="Sign In"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            HeightRequest="52"
                            AutomationId="LoginButton"/>

                        <!-- Activity indicator — 20dp gives visual separation from the button -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            Margin="0,20,0,0"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
