<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VenueOps.ViewModels"
    xmlns:models="clr-namespace:VenueOps.Models.Events"
    xmlns:conv="clr-namespace:VenueOps.Converters"
    x:Class="VenueOps.Views.Events.EventDetailView"
    x:DataType="vm:EventDetailViewModel"
    Title=""
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- ── Converters ──────────────────────────────────────────────── -->
        <conv:UtcToLocalConverter x:Key="UtcToLocal" Format="MMM d, h:mm tt"/>
        <conv:EventStatusConverter x:Key="EventStatus"/>

        <!-- ── Section card header label ───────────────────────────────── -->
        <Style x:Key="CardSectionLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CharacterSpacing" Value="0.8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource BrandMid},
                                            Dark={StaticResource BrandLight}}"/>
        </Style>

        <!-- ── Stat tile key (wide layout metrics row) ─────────────────── -->
        <Style x:Key="TileKey" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="CharacterSpacing" Value="0.7"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource BrandMid},
                                            Dark={StaticResource BrandLight}}"/>
        </Style>

        <!-- ── Stat tile value ─────────────────────────────────────────── -->
        <Style x:Key="TileValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineBreakMode" Value="WordWrap"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                            Dark={StaticResource TextPrimaryDark}}"/>
        </Style>

        <!-- ── Stat tile card ──────────────────────────────────────────── -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource BorderLight},
                                            Dark={StaticResource BorderDark}}"/>
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource SurfaceLight},
                                            Dark={StaticResource SurfaceDark}}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- ── Detail field key (compact layout left column) ──────────── -->
        <Style x:Key="DetailKey" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="WidthRequest" Value="110"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                            Dark={StaticResource TextSecondaryDark}}"/>
        </Style>

        <!-- ── Detail field value (compact layout right column) ────────── -->
        <Style x:Key="DetailValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineBreakMode" Value="WordWrap"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                            Dark={StaticResource TextPrimaryDark}}"/>
        </Style>

        <!-- ── Tappable link row label ──────────────────────────────────── -->
        <Style x:Key="LinkLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource BrandMid},
                                            Dark={StaticResource BrandLight}}"/>
        </Style>

        <!-- ── Error heading ───────────────────────────────────────────── -->
        <Style x:Key="ErrorHeading" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                            Dark={StaticResource TextPrimaryDark}}"/>
        </Style>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════════════════════
             FIXED BRAND HEADER (non-scrolling)
             ════════════════════════════════════════════════════════ -->
        <Grid
            Grid.Row="0"
            Padding="16,10,16,8"
            BackgroundColor="{AppThemeBinding
                Light={StaticResource BackgroundLight},
                Dark={StaticResource BackgroundDark}}">

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">

                <Label
                    Text="VenueOps"
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding
                        Light={StaticResource BrandDark},
                        Dark={StaticResource BrandLight}}"/>

                <BoxView
                    WidthRequest="1.5"
                    HeightRequest="18"
                    CornerRadius="1"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding
                        Light={StaticResource Gray300},
                        Dark={StaticResource Gray600}}"/>

                <Label
                    Text="Event Detail"
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    VerticalOptions="Center"
                    Opacity="0.65"
                    TextColor="{AppThemeBinding
                        Light={StaticResource TextSecondaryLight},
                        Dark={StaticResource TextSecondaryDark}}"/>

            </HorizontalStackLayout>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             SCROLLABLE CONTENT
             ════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <Grid>

                <!-- ── LOADING ────────────────────────────────────────── -->
                <Grid
                    IsVisible="{Binding IsBusy}"
                    HeightRequest="360"
                    VerticalOptions="Center">
                    <ActivityIndicator
                        IsRunning="True"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Grid>

                <!-- ── ERROR ──────────────────────────────────────────── -->
                <VerticalStackLayout
                    IsVisible="{Binding IsLoadError}"
                    Spacing="16"
                    Padding="32,60,32,32"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="Couldn't load event"
                        Style="{StaticResource ErrorHeading}"/>
                    <Label
                        Text="Please check your connection and try again."
                        Style="{StaticResource BodySecondary}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"/>
                    <Button
                        Text="Retry"
                        Command="{Binding RetryCommand}"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="120"/>

                </VerticalStackLayout>

                <!-- ── CONTENT ───────────────────────────────────────── -->
                <VerticalStackLayout
                    IsVisible="{Binding HasContent}"
                    Spacing="0">

                    <!-- ═══════════════════════════════════════════════════
                         COMPACT LAYOUT  (phones / portrait tablets)
                         ═══════════════════════════════════════════════════ -->
                    <VerticalStackLayout
                        IsVisible="{Binding IsCompactLayout}"
                        Spacing="0">

                        <!-- Hero area -->
                        <Grid HeightRequest="220" IsClippedToBounds="True">

                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush EndPoint="1,1">
                                        <GradientStop Color="{StaticResource BrandDark}" Offset="0"/>
                                        <GradientStop Color="{StaticResource BrandMid}"  Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                            </Grid>

                            <Image
                                Source="{Binding HeroImageUrl}"
                                Aspect="AspectFill"
                                IsVisible="{Binding HasHeroImage}"/>

                            <Grid IsVisible="{Binding HasHeroImage}">
                                <Grid.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0.35"/>
                                        <GradientStop Color="#CC000000"   Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                            </Grid>

                            <VerticalStackLayout
                                VerticalOptions="End"
                                Padding="16,0,16,16"
                                Spacing="8">
                                <Label
                                    Text="{Binding Detail.EventName}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="22"
                                    TextColor="White"
                                    LineBreakMode="WordWrap"/>
                                <Border
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    Padding="8,4"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding Detail.Status,
                                        Converter={StaticResource EventStatus},
                                        ConverterParameter=background}">
                                    <Label
                                        Text="{Binding Detail.Status,
                                            Converter={StaticResource EventStatus},
                                            ConverterParameter=label}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        TextColor="{Binding Detail.Status,
                                            Converter={StaticResource EventStatus},
                                            ConverterParameter=text}"/>
                                </Border>
                            </VerticalStackLayout>

                        </Grid>

                        <!-- Body cards -->
                        <VerticalStackLayout Spacing="14" Padding="16,16,16,0">

                            <!-- Key Details -->
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="DETAILS" Style="{StaticResource CardSectionLabel}"/>
                                    <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,10">
                                        <Label Grid.Column="0" Text="Date"        Style="{StaticResource DetailKey}"/>
                                        <Label Grid.Column="1" Text="{Binding DateRangeDisplay}" Style="{StaticResource DetailValue}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,10">
                                        <Label Grid.Column="0" Text="Venue"       Style="{StaticResource DetailKey}"/>
                                        <Label Grid.Column="1" Text="{Binding Detail.VenueName}" Style="{StaticResource DetailValue}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,10">
                                        <Label Grid.Column="0" Text="{Binding AttendeesLabel}" Style="{StaticResource DetailKey}"/>
                                        <Label Grid.Column="1" Text="{Binding AttendeesDisplay}" Style="{StaticResource DetailValue}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="Booking Ref" Style="{StaticResource DetailKey}"/>
                                        <Label Grid.Column="1" Text="{Binding Detail.BookingReference}" Style="{StaticResource DetailValue}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- About -->
                            <Border Style="{StaticResource Card}" IsVisible="{Binding HasDescription}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="ABOUT" Style="{StaticResource CardSectionLabel}"/>
                                    <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                    <Label
                                        Text="{Binding Detail.ShortDescription}"
                                        Style="{StaticResource BodySecondary}"
                                        LineBreakMode="WordWrap"
                                        FontSize="14"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Location -->
                            <Border Style="{StaticResource Card}" IsVisible="{Binding HasLocation}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="LOCATION" Style="{StaticResource CardSectionLabel}"/>
                                    <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                    <Label
                                        Text="{Binding Detail.Location.FormattedAddress}"
                                        Style="{StaticResource BodySecondary}"
                                        LineBreakMode="WordWrap"
                                        FontSize="14"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Organizer -->
                            <Border Style="{StaticResource Card}" IsVisible="{Binding HasOrganizer}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="ORGANIZER" Style="{StaticResource CardSectionLabel}"/>
                                    <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                    <Label
                                        Text="{Binding Detail.Organizer.Name}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="15"
                                        TextColor="{AppThemeBinding
                                            Light={StaticResource TextPrimaryLight},
                                            Dark={StaticResource TextPrimaryDark}}"/>
                                    <Label
                                        Text="{Binding Detail.Organizer.WebsiteUrl}"
                                        IsVisible="{Binding OrganizerHasWebsite}"
                                        FontSize="13"
                                        Margin="0,6,0,0"
                                        TextDecorations="Underline"
                                        TextColor="{AppThemeBinding
                                            Light={StaticResource BrandMid},
                                            Dark={StaticResource BrandLight}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenLinkCommand}"
                                                CommandParameter="{Binding Detail.Organizer.WebsiteUrl}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Tags -->
                            <Border Style="{StaticResource Card}" IsVisible="{Binding HasTags}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="TAGS" Style="{StaticResource CardSectionLabel}"/>
                                    <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                    <FlexLayout
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="Start"
                                        AlignItems="Center"
                                        BindableLayout.ItemsSource="{Binding Detail.Tags}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Margin="0,0,6,6"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding
                                                        Light={StaticResource BrandLight},
                                                        Dark={StaticResource BorderDark}}"
                                                    BackgroundColor="{AppThemeBinding
                                                        Light={StaticResource Gray100},
                                                        Dark={StaticResource SurfaceVariantDark}}"
                                                    Padding="10,5">
                                                    <Label
                                                        Text="{Binding .}"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="12"
                                                        TextColor="{AppThemeBinding
                                                            Light={StaticResource TextSecondaryLight},
                                                            Dark={StaticResource TextSecondaryDark}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Links -->
                            <Border Style="{StaticResource Card}" IsVisible="{Binding HasLinks}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="LINKS" Style="{StaticResource CardSectionLabel}"/>
                                    <BoxView HeightRequest="1"/>
                                    <VerticalStackLayout
                                        Spacing="0"
                                        BindableLayout.ItemsSource="{Binding Detail.Links}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventLink">
                                                <VerticalStackLayout Spacing="0">
                                                    <Grid
                                                        ColumnDefinitions="Auto,*,Auto"
                                                        Padding="0,14,0,14">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLinkCommand}"
                                                                CommandParameter="{Binding Url}"/>
                                                        </Grid.GestureRecognizers>
                                                        <Image
                                                            Grid.Column="0"
                                                            Source="{AppThemeBinding Light=link.png, Dark=link_dark.png}"
                                                            HeightRequest="16"
                                                            WidthRequest="16"
                                                            VerticalOptions="Center"
                                                            Margin="0,0,10,0"/>
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding Label}"
                                                            Style="{StaticResource LinkLabel}"
                                                            VerticalOptions="Center"/>
                                                        <Label
                                                            Grid.Column="2"
                                                            Text="→"
                                                            FontFamily="OpenSansSemibold"
                                                            FontSize="16"
                                                            VerticalOptions="Center"
                                                            TextColor="{AppThemeBinding
                                                                Light={StaticResource BrandMid},
                                                                Dark={StaticResource BrandLight}}"/>
                                                    </Grid>
                                                    <BoxView HeightRequest="1"/>
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Image credit -->
                            <Label
                                Text="{Binding HeroImageCredit, StringFormat='Photo credit: {0}'}"
                                IsVisible="{Binding HasImageCredit}"
                                Style="{StaticResource Caption}"
                                HorizontalTextAlignment="Center"
                                Margin="0,4,0,0"/>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="32" BackgroundColor="Transparent"/>

                    </VerticalStackLayout>

                    <!-- ═══════════════════════════════════════════════════
                         WIDE LAYOUT  (landscape tablets / desktop)

                         Structure:
                           1. Full-width hero banner (300px) — name, status,
                              photo credit corner
                           2. Key metrics row — 4 stat tiles (Date, Venue,
                              Attendees, Booking Ref)
                           3. Two-column body:
                                Left (3*) — About, Location, Organizer
                                Right (2*) — Tags, Links
                           4. Gallery strip — horizontal scroll (conditional)
                         ═══════════════════════════════════════════════════ -->
                    <VerticalStackLayout
                        IsVisible="{Binding IsWideLayout}"
                        Spacing="0">

                        <!-- ── 1. Full-width Hero Banner ───────────────── -->
                        <Grid HeightRequest="300" IsClippedToBounds="True">

                            <!-- Brand gradient fallback -->
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush EndPoint="1,1">
                                        <GradientStop Color="{StaticResource BrandDark}" Offset="0"/>
                                        <GradientStop Color="{StaticResource BrandMid}"  Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                            </Grid>

                            <!-- Hero photo -->
                            <Image
                                Source="{Binding HeroImageUrl}"
                                Aspect="AspectFill"
                                IsVisible="{Binding HasHeroImage}"/>

                            <!-- Dark scrim for text legibility -->
                            <Grid IsVisible="{Binding HasHeroImage}">
                                <Grid.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0.3"/>
                                        <GradientStop Color="#D9000000"   Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                            </Grid>

                            <!-- Event name + status badge (bottom-left) -->
                            <VerticalStackLayout
                                VerticalOptions="End"
                                HorizontalOptions="Start"
                                Padding="24,0,24,24"
                                Spacing="10">
                                <Label
                                    Text="{Binding Detail.EventName}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="30"
                                    TextColor="White"
                                    LineBreakMode="WordWrap"
                                    MaximumWidthRequest="700"/>
                                <Border
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    Padding="10,5"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding Detail.Status,
                                        Converter={StaticResource EventStatus},
                                        ConverterParameter=background}">
                                    <Label
                                        Text="{Binding Detail.Status,
                                            Converter={StaticResource EventStatus},
                                            ConverterParameter=label}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        TextColor="{Binding Detail.Status,
                                            Converter={StaticResource EventStatus},
                                            ConverterParameter=text}"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Photo credit (bottom-right corner) -->
                            <Label
                                Text="{Binding HeroImageCredit}"
                                IsVisible="{Binding HasImageCredit}"
                                FontFamily="OpenSansRegular"
                                FontSize="10"
                                TextColor="#BBFFFFFF"
                                VerticalOptions="End"
                                HorizontalOptions="End"
                                Margin="0,0,14,10"/>

                        </Grid>

                        <!-- ── 2. Key Metrics Row (4 stat tiles) ──────── -->
                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            ColumnSpacing="10"
                            Margin="16,16,16,0">

                            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="DATE" Style="{StaticResource TileKey}"/>
                                    <Label Text="{Binding DateRangeDisplay}" Style="{StaticResource TileValue}"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource StatTile}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="VENUE" Style="{StaticResource TileKey}"/>
                                    <Label Text="{Binding Detail.VenueName}" Style="{StaticResource TileValue}"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="{Binding AttendeesLabel}" Style="{StaticResource TileKey}"/>
                                    <Label Text="{Binding AttendeesDisplay}" Style="{StaticResource TileValue}"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource StatTile}">
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="BOOKING REF" Style="{StaticResource TileKey}"/>
                                    <Label Text="{Binding Detail.BookingReference}" Style="{StaticResource TileValue}"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <!-- ── 3. Two-column body ─────────────────────── -->
                        <!--
                            Left (3*):  narrative sections — About, Location, Organizer
                            Right (2*): structured data   — Tags, Links
                        -->
                        <Grid
                            ColumnDefinitions="3*,2*"
                            ColumnSpacing="14"
                            Margin="16,14,16,0">

                            <!-- Left column -->
                            <VerticalStackLayout Grid.Column="0" Spacing="14">

                                <!-- About -->
                                <Border Style="{StaticResource Card}" IsVisible="{Binding HasDescription}">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="ABOUT" Style="{StaticResource CardSectionLabel}"/>
                                        <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                        <Label
                                            Text="{Binding Detail.ShortDescription}"
                                            Style="{StaticResource BodySecondary}"
                                            LineBreakMode="WordWrap"
                                            FontSize="14"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Location -->
                                <Border Style="{StaticResource Card}" IsVisible="{Binding HasLocation}">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="LOCATION" Style="{StaticResource CardSectionLabel}"/>
                                        <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                        <Label
                                            Text="{Binding Detail.Location.FormattedAddress}"
                                            Style="{StaticResource BodySecondary}"
                                            LineBreakMode="WordWrap"
                                            FontSize="14"/>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Organizer -->
                                <Border Style="{StaticResource Card}" IsVisible="{Binding HasOrganizer}">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="ORGANIZER" Style="{StaticResource CardSectionLabel}"/>
                                        <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                        <Label
                                            Text="{Binding Detail.Organizer.Name}"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="15"
                                            TextColor="{AppThemeBinding
                                                Light={StaticResource TextPrimaryLight},
                                                Dark={StaticResource TextPrimaryDark}}"/>
                                        <Label
                                            Text="{Binding Detail.Organizer.WebsiteUrl}"
                                            IsVisible="{Binding OrganizerHasWebsite}"
                                            FontSize="13"
                                            Margin="0,6,0,0"
                                            TextDecorations="Underline"
                                            TextColor="{AppThemeBinding
                                                Light={StaticResource BrandMid},
                                                Dark={StaticResource BrandLight}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding OpenLinkCommand}"
                                                    CommandParameter="{Binding Detail.Organizer.WebsiteUrl}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>

                            <!-- Right column -->
                            <VerticalStackLayout Grid.Column="1" Spacing="14">

                                <!-- Tags -->
                                <Border Style="{StaticResource Card}" IsVisible="{Binding HasTags}">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="TAGS" Style="{StaticResource CardSectionLabel}"/>
                                        <BoxView HeightRequest="1" Margin="0,0,0,14"/>
                                        <FlexLayout
                                            Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="Start"
                                            AlignItems="Center"
                                            BindableLayout.ItemsSource="{Binding Detail.Tags}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border
                                                        Margin="0,0,6,6"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="1"
                                                        Stroke="{AppThemeBinding
                                                            Light={StaticResource BrandLight},
                                                            Dark={StaticResource BorderDark}}"
                                                        BackgroundColor="{AppThemeBinding
                                                            Light={StaticResource Gray100},
                                                            Dark={StaticResource SurfaceVariantDark}}"
                                                        Padding="10,5">
                                                        <Label
                                                            Text="{Binding .}"
                                                            FontFamily="OpenSansRegular"
                                                            FontSize="12"
                                                            TextColor="{AppThemeBinding
                                                                Light={StaticResource TextSecondaryLight},
                                                                Dark={StaticResource TextSecondaryDark}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Links -->
                                <Border Style="{StaticResource Card}" IsVisible="{Binding HasLinks}">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="LINKS" Style="{StaticResource CardSectionLabel}"/>
                                        <BoxView HeightRequest="1"/>
                                        <VerticalStackLayout
                                            Spacing="0"
                                            BindableLayout.ItemsSource="{Binding Detail.Links}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:EventLink">
                                                    <VerticalStackLayout Spacing="0">
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            Padding="0,14,0,14">
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLinkCommand}"
                                                                    CommandParameter="{Binding Url}"/>
                                                            </Grid.GestureRecognizers>
                                                            <Image
                                                                Grid.Column="0"
                                                                Source="{AppThemeBinding Light=link.png, Dark=link_dark.png}"
                                                                HeightRequest="16"
                                                                WidthRequest="16"
                                                                VerticalOptions="Center"
                                                                Margin="0,0,10,0"/>
                                                            <Label
                                                                Grid.Column="1"
                                                                Text="{Binding Label}"
                                                                Style="{StaticResource LinkLabel}"
                                                                VerticalOptions="Center"/>
                                                            <Label
                                                                Grid.Column="2"
                                                                Text="→"
                                                                FontFamily="OpenSansSemibold"
                                                                FontSize="16"
                                                                VerticalOptions="Center"
                                                                TextColor="{AppThemeBinding
                                                                    Light={StaticResource BrandMid},
                                                                    Dark={StaticResource BrandLight}}"/>
                                                        </Grid>
                                                        <BoxView HeightRequest="1"/>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>

                        </Grid>

                        <!-- ── 4. Photo Gallery (horizontal scroll strip) ──
                             Only shown when the event has more than one image.
                             Each tile: 240×160 rounded card with image fill and
                             a bottom-gradient credit overlay.
                             ─────────────────────────────────────────────────── -->
                        <Border
                            Style="{StaticResource Card}"
                            IsVisible="{Binding HasGalleryImages}"
                            Margin="16,14,16,0">
                            <VerticalStackLayout Spacing="0">

                                <Label Text="GALLERY" Style="{StaticResource CardSectionLabel}"/>
                                <BoxView HeightRequest="1" Margin="0,0,0,14"/>

                                <ScrollView Orientation="Horizontal">
                                    <HorizontalStackLayout
                                        Spacing="10"
                                        BindableLayout.ItemsSource="{Binding GalleryImages}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:EventImage">

                                                <Border
                                                    StrokeShape="RoundRectangle 8"
                                                    StrokeThickness="0"
                                                    WidthRequest="240"
                                                    HeightRequest="160">
                                                    <Grid>

                                                        <!-- Photo -->
                                                        <Image Source="{Binding Url}" Aspect="AspectFill"/>

                                                        <!-- Bottom scrim for credit readability -->
                                                        <Grid>
                                                            <Grid.Background>
                                                                <LinearGradientBrush EndPoint="0,1">
                                                                    <GradientStop Color="Transparent" Offset="0.55"/>
                                                                    <GradientStop Color="#AA000000"   Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Grid.Background>
                                                        </Grid>

                                                        <!-- Credit text -->
                                                        <Label
                                                            Text="{Binding Credit}"
                                                            FontFamily="OpenSansRegular"
                                                            FontSize="10"
                                                            TextColor="#CCFFFFFF"
                                                            VerticalOptions="End"
                                                            HorizontalOptions="End"
                                                            Margin="0,0,8,6"/>

                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>

                            </VerticalStackLayout>
                        </Border>

                        <!-- Bottom spacer -->
                        <BoxView HeightRequest="32" BackgroundColor="Transparent"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>

    </Grid>

</ContentPage>
