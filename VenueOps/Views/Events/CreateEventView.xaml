<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:TypeArguments="system:Boolean"
    xmlns:vm="clr-namespace:VenueOps.ViewModels"
    x:Class="VenueOps.Views.Events.CreateEventView"
    x:DataType="vm:CreateEventViewModel"
    x:Name="DialogCard"
    BackgroundColor="Transparent">

    <!--
        Outer Border gives the card-like dialog appearance (rounded corners,
        themed background, stroke) over the semi-transparent backdrop that the
        Popup control renders automatically.
    -->
    <Border
        StrokeShape="RoundRectangle 16"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light={StaticResource BorderLight},
                                 Dark={StaticResource BorderDark}}"
        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                          Dark={StaticResource SurfaceDark}}"
        Padding="0">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ════════════════════════════════════════════════════════
                 DIALOG HEADER — title + dismiss (✕)
                 ════════════════════════════════════════════════════════ -->
            <VerticalStackLayout
                Grid.Row="0"
                Spacing="0"
                BackgroundColor="{AppThemeBinding
                    Light={StaticResource SurfaceLight},
                    Dark={StaticResource SurfaceDark}}">

                <Grid ColumnDefinitions="*,Auto" Padding="24,20,16,20">

                    <Label
                        Grid.Column="0"
                        Text="New Event"
                        Style="{StaticResource SubHeadline}"
                        VerticalOptions="Center"/>

                    <Button
                        Grid.Column="1"
                        Text="✕"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextSecondaryLight},
                            Dark={StaticResource TextSecondaryDark}}"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        CornerRadius="22"
                        BorderWidth="0"
                        VerticalOptions="Center"/>

                </Grid>

                <BoxView HeightRequest="1"/>

            </VerticalStackLayout>

            <!-- ════════════════════════════════════════════════════════
                 FORM BODY — two layouts toggled by IsWideLayout
                 ════════════════════════════════════════════════════════ -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="24,20,24,12">

                    <!-- ── WIDE layout (≥ 480 dp popup width): 2 cols ───────── -->
                    <VerticalStackLayout IsVisible="{Binding IsWideLayout}" Spacing="18">

                        <!-- Event Name | Venue Name -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Event Name *" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Entry
                                        Placeholder="New event name..."
                                        Text="{Binding EventName}"
                                        ReturnType="Next"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Venue Name *" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Entry
                                        Placeholder="Venue name..."
                                        Text="{Binding VenueName}"
                                        ReturnType="Next"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Status | Expected Attendees -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Status" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Picker
                                        ItemsSource="{Binding StatusOptions}"
                                        SelectedItem="{Binding Status}"
                                        Title="Select status"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Expected Attendees" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Entry
                                        Placeholder="Attendee count..."
                                        Text="{Binding AttendeeCountText}"
                                        Keyboard="Numeric"
                                        ReturnType="Done"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Start Date+Time | End Date+Time -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Start Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" Padding="0" Style="{StaticResource InputBorder}">
                                        <DatePicker Date="{Binding StartDate}"/>
                                    </Border>
                                    <Border Grid.Column="1" Padding="0" Style="{StaticResource InputBorder}">
                                        <TimePicker Time="{Binding StartTime}"/>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="End Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" Padding="0" Style="{StaticResource InputBorder}">
                                        <DatePicker Date="{Binding EndDate}"/>
                                    </Border>
                                    <Border Grid.Column="1" Padding="0" Style="{StaticResource InputBorder}">
                                        <TimePicker Time="{Binding EndTime}"/>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- ── COMPACT layout (< 480 dp popup width): 1 col ──────── -->
                    <VerticalStackLayout IsVisible="{Binding IsCompactLayout}" Spacing="18">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Event Name *" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="New event name..."
                                    Text="{Binding EventName}"
                                    ReturnType="Next"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Venue Name *" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Venue name..."
                                    Text="{Binding VenueName}"
                                    ReturnType="Next"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Status" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Picker
                                    ItemsSource="{Binding StatusOptions}"
                                    SelectedItem="{Binding Status}"
                                    Title="Select status"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Start Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Padding="0" Style="{StaticResource InputBorder}">
                                    <DatePicker Date="{Binding StartDate}"/>
                                </Border>
                                <Border Grid.Column="1" Padding="0" Style="{StaticResource InputBorder}">
                                    <TimePicker Time="{Binding StartTime}"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="End Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Padding="0" Style="{StaticResource InputBorder}">
                                    <DatePicker Date="{Binding EndDate}"/>
                                </Border>
                                <Border Grid.Column="1" Padding="0" Style="{StaticResource InputBorder}">
                                    <TimePicker Time="{Binding EndTime}"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Expected Attendees" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Attendee count..."
                                    Text="{Binding AttendeeCountText}"
                                    Keyboard="Numeric"
                                    ReturnType="Done"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ── Validation error ───────────────────────────────────── -->
                    <Label
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource ErrorText}"
                        IsVisible="{Binding HasError}"
                        Margin="0,8,0,0"/>

                    <!-- ── Loading indicator ──────────────────────────────────── -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center"
                        Margin="0,8,0,0"/>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ════════════════════════════════════════════════════════
                 DIALOG FOOTER — Cancel + Create buttons
                 ════════════════════════════════════════════════════════ -->
            <VerticalStackLayout
                Grid.Row="2"
                Spacing="0"
                BackgroundColor="{AppThemeBinding
                    Light={StaticResource SurfaceLight},
                    Dark={StaticResource SurfaceDark}}">

                <BoxView HeightRequest="1"/>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Padding="24,12,24,20">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButton}"
                        IsEnabled="{Binding IsNotBusy}"/>

                    <Button
                        Grid.Column="1"
                        Text="Create Event"
                        Command="{Binding SubmitCommand}"/>

                </Grid>

            </VerticalStackLayout>

        </Grid>
    </Border>
</toolkit:Popup>
