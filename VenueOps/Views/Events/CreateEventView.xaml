<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:TypeArguments="system:Boolean"
    xmlns:vm="clr-namespace:VenueOps.ViewModels"
    x:Class="VenueOps.Views.Events.CreateEventView"
    x:DataType="vm:CreateEventViewModel"
    x:Name="DialogCard"
    BackgroundColor="Transparent">

    <Border
        x:Name="RootBorder"
        StrokeShape="RoundRectangle 16"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light={StaticResource BorderLight},
                                 Dark={StaticResource BorderDark}}"
        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                          Dark={StaticResource SurfaceDark}}"
        Padding="0">

        <!--
            Single ScrollView wraps everything — header, form, and footer move
            together as one unit. The Border is content-sized up to
            MaximumHeightRequest (set from code-behind), so on large windows
            there is no scroll at all; on small windows the whole modal scrolls.
        -->
        <ScrollView Orientation="Both">
            <VerticalStackLayout Spacing="0">

                <!-- ════════════════════════════════════════════════════════
                     HEADER — title + dismiss (✕)
                     ════════════════════════════════════════════════════════ -->
                <Grid ColumnDefinitions="*,Auto" Padding="24,20,16,20">

                    <Label
                        Grid.Column="0"
                        Text="Create New Event"
                        Style="{StaticResource SubHeadline}"
                        VerticalOptions="Center"/>

                    <Button
                        Grid.Column="1"
                        Text="✕"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding
                            Light={StaticResource TextSecondaryLight},
                            Dark={StaticResource TextSecondaryDark}}"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0"
                        CornerRadius="22"
                        BorderWidth="0"
                        VerticalOptions="Center"/>

                </Grid>

                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource BorderLight},
                                            Dark={StaticResource BorderDark}}"/>

                <!-- ════════════════════════════════════════════════════════
                     FORM BODY — two layouts toggled by IsWideLayout
                     ════════════════════════════════════════════════════════ -->
                <VerticalStackLayout Padding="24,20,24,12">

                    <!-- ── WIDE layout (≥ 480 dp popup width): 2 cols ───────── -->
                    <VerticalStackLayout IsVisible="{Binding IsWideLayout}" Spacing="18">

                        <!-- Event Name | Venue Name -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Event Name *" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Entry
                                        Placeholder="New event name..."
                                        Text="{Binding EventName}"
                                        ReturnType="Next"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Venue Name *" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Entry
                                        Placeholder="Venue name..."
                                        Text="{Binding VenueName}"
                                        ReturnType="Next"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Status | Expected Attendees -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Status" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Picker
                                        ItemsSource="{Binding StatusOptions}"
                                        SelectedItem="{Binding Status}"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Expected Attendees" Style="{StaticResource FieldLabel}"/>
                                <Border Padding="0" Style="{StaticResource InputBorder}">
                                    <Entry
                                        Placeholder="Attendee count..."
                                        Text="{Binding AttendeeCountText}"
                                        Keyboard="Numeric"
                                        ReturnType="Done"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Start Date+Time | End Date+Time -->
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Start Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" VerticalOptions="Center">
                                    <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                        <DatePicker
                                            Date="{Binding StartDate}"
                                            WidthRequest="150"
                                            HeightRequest="50"/>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource InputBorder}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="0,9,0,0"
                                        HeightRequest="35">
                                        <TimePicker
                                            Time="{Binding StartTime}"
                                            Margin="0,8,0,-8"/>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="End Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                                <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" VerticalOptions="Center">
                                    <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                        <DatePicker
                                            Date="{Binding EndDate}"
                                            WidthRequest="150"
                                            HeightRequest="50"/>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Style="{StaticResource InputBorder}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="0,9,0,0"
                                        HeightRequest="35">
                                        <TimePicker
                                            Time="{Binding EndTime}"
                                            Margin="0,8,0,-8"/>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ── COMPACT layout (< 480 dp popup width): 1 col ──────── -->
                    <VerticalStackLayout IsVisible="{Binding IsCompactLayout}" Spacing="18">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Event Name *" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="New event name..."
                                    Text="{Binding EventName}"
                                    ReturnType="Next"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Venue Name *" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Venue name..."
                                    Text="{Binding VenueName}"
                                    ReturnType="Next"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Status" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Picker
                                    ItemsSource="{Binding StatusOptions}"
                                    SelectedItem="{Binding Status}"
                                    Title="Select status"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Start Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                            <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" VerticalOptions="Center">
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                    <DatePicker
                                        Date="{Binding StartDate}"
                                        WidthRequest="150"
                                        HeightRequest="50"/>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource InputBorder}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    Margin="0,9,0,0"
                                    HeightRequest="35">
                                    <TimePicker
                                        Time="{Binding StartTime}"
                                        Margin="0,8,0,-8"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="End Date &amp; Time *" Style="{StaticResource FieldLabel}"/>
                            <Grid ColumnDefinitions="auto,*" ColumnSpacing="15" VerticalOptions="Center">
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                    <DatePicker
                                        Date="{Binding EndDate}"
                                        WidthRequest="150"
                                        HeightRequest="50"/>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource InputBorder}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    Margin="0,9,0,0"
                                    HeightRequest="35">
                                    <TimePicker
                                        Time="{Binding EndTime}"
                                        Margin="0,8,0,-8"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Expected Attendees" Style="{StaticResource FieldLabel}"/>
                            <Border Padding="0" Style="{StaticResource InputBorder}">
                                <Entry
                                    Placeholder="Attendee count..."
                                    Text="{Binding AttendeeCountText}"
                                    Keyboard="Numeric"
                                    ReturnType="Done"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- ── Validation error ───────────────────────────────────── -->
                    <Label
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource ErrorText}"
                        IsVisible="{Binding HasError}"
                        Margin="0,8,0,0"/>

                    <!-- ── Loading indicator ──────────────────────────────────── -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        HorizontalOptions="Center"
                        Margin="0,8,0,0"/>

                </VerticalStackLayout>

                <!-- ════════════════════════════════════════════════════════
                     FOOTER — Cancel + Create buttons
                     ════════════════════════════════════════════════════════ -->
                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource BorderLight},
                                            Dark={StaticResource BorderDark}}"/>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Padding="24,25,24,20">

                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButton}"
                        IsEnabled="{Binding IsNotBusy}"/>

                    <Button
                        Grid.Column="1"
                        Text="Create Event"
                        Command="{Binding SubmitCommand}"/>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Border>
</toolkit:Popup>
