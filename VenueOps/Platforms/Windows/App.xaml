<maui:MauiWinUIApplication
    x:Class="VenueOps.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:VenueOps.WinUI">

    <Application.Resources>
        <ResourceDictionary>
            <!--
                Remove all default WinUI NavigationViewItem visual chrome so that
                our custom Shell.ItemTemplate is the sole visual layer.

                WinUI 3 state names: Normal, PointerOver, Pressed, Selected,
                SelectedPointerOver, SelectedPressed, Disabled — NOT "Hover".
            -->

            <!-- Vertical accent bar shown on the selected item's left edge -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground"          Color="Transparent"/>

            <!-- Item background for every interactive state -->
            <SolidColorBrush x:Key="NavigationViewItemBackground"                        Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"             Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"                 Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"                Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver"     Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"         Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundDisabled"                Color="Transparent"/>

            <!-- Item border brush for every interactive state -->
            <SolidColorBrush x:Key="NavigationViewItemBorderBrush"                       Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushPointerOver"            Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushPressed"                Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelected"               Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelectedPointerOver"    Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushSelectedPressed"        Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBorderBrushDisabled"               Color="Transparent"/>
        </ResourceDictionary>
    </Application.Resources>

</maui:MauiWinUIApplication>
